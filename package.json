{
  "name": "ShenlunApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "bundle:debug": "react-native bundle --platform android --dev true --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "bundle:release": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "build:data": "node scripts/build-local-data.mjs",
    "postinstall": "patch-package",
    "_build:debug": "cd android && node -e \"const{platform}=require('os');const cmd=platform==='win32'?'gradlew.bat':'./gradlew';require('child_process').execSync(cmd+' clean assembleDebug',{stdio:'inherit'})\"",
    "_build:release": "cd android && node -e \"const{platform}=require('os');const cmd=platform==='win32'?'gradlew.bat':'./gradlew';require('child_process').execSync(cmd+' clean assembleRelease',{stdio:'inherit'})\"",
    "build:debug": "npm run bundle:release && npm run _build:debug",
    "build:release": "npm run bundle:release && npm run _build:release"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "react": "^18.2.0",
    "react-native": "^0.77.3",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "~4.13.1",
    "react-native-splash-screen": "^3.3.0",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/babel-preset": "^0.77.3",
    "@react-native/eslint-config": "^0.77.3",
    "@react-native/metro-config": "^0.77.3",
    "@react-native/typescript-config": "^0.77.3",
    "@types/react": "^18.3.31",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}

{
  "name": "ShenlunApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "bundle:debug": "react-native bundle --platform android --dev true --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "bundle:release": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "_build:apk": "cd android && node -e \"const{platform}=require('os');const cmd=platform==='win32'?'gradlew.bat':'./gradlew';require('child_process').execSync(cmd+' clean assembleDebug',{stdio:'inherit'})\"",
    "build:debug": "npm run bundle:release && npm run _build:apk",
    "build:release": "npm run bundle:release && cd android && node -e \"const{platform}=require('os');const cmd=platform==='win32'?'gradlew.bat':'./gradlew';require('child_process').execSync(cmd+' clean assembleRelease',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-mmkv": "^2.12.2",
    "react-native-safe-area-context": "^4.14.1",
    "react-native-screens": "^3.37.0",
    "react-native-splash-screen": "^3.3.0",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.74.87",
    "@react-native/eslint-config": "0.74.87",
    "@react-native/metro-config": "0.74.87",
    "@react-native/typescript-config": "0.74.87",
    "@types/react": "^18.3.31",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
